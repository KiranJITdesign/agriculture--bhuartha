DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

POSTGRES_DB=terraintel
POSTGRES_USER=terraintel
POSTGRES_PASSWORD=terraintel
POSTGRES_HOST=
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET_NAME=terraintel-artifacts
S3_REGION_NAME=us-east-1

# Satellite data provider: "stac" (open-source Element84 Earth Search, no key required)
# or "gee" (requires GEE_PROJECT_ID + credentials)
SATELLITE_PROVIDER=stac
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_KEY=

# Optional OpenAI / OpenRouter key for Agronomic Copilot
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
